# NTACBT environment
#
# Everything works with an EMPTY file — the app is local-first and every
# academic dataset is baked at build time. Fill these in only to enable the
# optional enhancements described below.
#
# NEVER commit a filled-in .env. (Note: a .env with real Supabase values is
# currently tracked in this repo — see docs/REDEVELOPMENT-PLAN.md §9.)

# --- Client (Vite) -----------------------------------------------------------
# Base URL for the JSON API. Leave empty to use the same origin.
VITE_API_URL=

# Supabase (optional). When BOTH are set, the app gains an account layer and a
# shared public test library. When either is missing, everything stays on-device
# and no account is required.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Server only (never exposed to the browser) ------------------------------
# Saarthi AI chat. With no keys the endpoint returns 503 with a clear message
# instead of crashing — correct degradation, not a bug.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_MODEL_LIGHT=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MODEL_LIGHT=

# Supabase service role — server routes only.
SUPABASE_URL=
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
