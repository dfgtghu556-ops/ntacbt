# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
.output
.vinxi
.tanstack/**
.nitro
*.local

# Vercel Build Output API artifact (the whole server bundle + static assets).
# `npm run build` writes it; one `git add -A` would commit megabytes.
.vercel/

# Wrangler / Cloudflare
.wrangler/
.dev.vars

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Baked PYQ papers (regenerated by scripts/build-pyq.mjs on every build)
public/pyq/

# JEE 2026 user PDFs + OCR scratch + in-progress transcriptions (huge; regenerated).
# COMPLETED papers live in data/jee2026/transcribed/ and ARE committed (they bake
# the user's own scans into the site's PYQ section at build time).
data/jee2026/*.pdf
data/jee2026/ocr/
data/jee2026/working/
data/jee2026/scripts/

# The quality-gate workflow is written and ready at .github/workflows/deploy.yml,
# but it cannot be pushed from a GitHub App session: App installation tokens
# carry no `workflows` scope, so `git push` refuses any commit that creates or
# updates a file under .github/workflows/ and the Contents API answers 403.
# Keeping it out of the index means a `git add -A` cannot break a push. Add it
# through the GitHub web UI, then delete this line.
.github/workflows/deploy.yml
